JAV_PILOT_JAVDB_FETCHER=auto
JAV_PILOT_BROWSER_WAIT_MS=3000
# Empty uses the browser bundled with the pinned Playwright runtime. Set a
# channel only when that exact browser is installed; startup then fails closed
# instead of silently changing browser identity and invalidating site trust.
JAV_PILOT_BROWSER_CHANNEL=

# Optional build-only proxy. Compose maps only this value to Docker's predefined
# proxy build arguments, so credentials stay out of Dockerfile history and the
# build cannot silently inherit ambient host proxy variables. With
# build.network=host on Linux, use the host listener address (for example
# http://127.0.0.1:7890), not host.docker.internal.
JAV_PILOT_BUILD_PROXY=

# Optional runtime browser/site proxy. Compose mirrors this one value into
# HTTP_PROXY, HTTPS_PROXY and ALL_PROXY so ambient host proxy variables cannot
# silently change container routing. Leave it empty when no proxy exists.
# For a host-side proxy exposed on port 7890, use
# http://host.docker.internal:7890.
JAV_PILOT_PROXY=
NO_PROXY=127.0.0.1,localhost,jav-pilot,host.docker.internal
# Proxy variables above enable known Fake-IP DNS compatibility automatically.
# Set this to 1 only when DNS returns Fake-IP addresses without a proxy variable.
JAV_PILOT_ALLOW_FAKE_IP_DNS=0

# qBittorrent is optional and is not included in this Compose project. Configure
# a reachable WebUI URL here or after login, such as http://host.docker.internal:8080
# for a host-published qBittorrent port. Its save/library paths below refer to
# the paths visible to qBittorrent; align them with the shared host mounts.
JAV_PILOT_QB_URL=
JAV_PILOT_QB_USERNAME=
JAV_PILOT_QB_PASSWORD=
JAV_PILOT_QB_CATEGORY=jav
JAV_PILOT_QB_SAVE_PATH=/downloads/jav
JAV_PILOT_QB_LIBRARY_PATH=/media/JAV
# Path exposing JAV_PILOT_QB_LIBRARY_PATH inside the jav-pilot container.
# The application-side qB library mount is fixed at /media/JAV in Compose.
JAV_PILOT_QB_ORGANIZER_INTERVAL_SECONDS=30
JAV_PILOT_QB_TAGS=jav-pilot
JAV_PILOT_QB_STAGING_HOST_PATH=./runtime/downloads/jav
JAV_PILOT_LIBRARY_HOST_PATH=./runtime/media/JAV

# MissAV exposes independent resource_search, web_download, and optional description
# capabilities. Resource discovery lives in Search and remains usable when downloading
# is disabled; only an explicit preview commit creates download tasks.
# Temporary HLS URLs and request headers stay in worker memory. Chromium trust,
# cookies, history and cache persist only in the dedicated browser-profile volume;
# they are outside /app/data and are never included in application snapshots.
JAV_PILOT_WEB_DOWNLOAD_ENABLED=1
JAV_PILOT_WEB_DOWNLOAD_HOST_PATH=./runtime/downloads/jav-web
# SQLite schemas: web_downloads=9, web_download_batches=10,
# download_replacements=6, resource_search=4.
# Compose fixes operations state at /app/data/web_downloads.sqlite3, Web staging
# at /downloads/jav-web, and the library at /media/JAV so mounts and backups cannot drift.
JAV_PILOT_WEB_DOWNLOAD_MAX_CONCURRENCY=8
# Server-owned batch scan budget, 1-64 pages. Clients cannot override it.
JAV_PILOT_WEB_DOWNLOAD_BATCH_PAGE_BUDGET=16
# Browser work is separately bounded even when media transfer concurrency is higher.
JAV_PILOT_MISSAV_BROWSER_CONCURRENCY=2
JAV_PILOT_WEB_DOWNLOAD_MIN_FREE_BYTES=5368709120
JAV_PILOT_WEB_DOWNLOAD_INITIAL_MEDIA_BYTES=536870912
JAV_PILOT_WEB_DOWNLOAD_MAX_FILE_BYTES=68719476736
JAV_PILOT_WEB_DOWNLOAD_CAPTURE_TIMEOUT_SECONDS=45
# Base free-space floor for readiness checks. Web paths also honor the larger
# JAV_PILOT_WEB_DOWNLOAD_MIN_FREE_BYTES reserve above.
JAV_PILOT_READINESS_MIN_FREE_BYTES=67108864

# Generate missing NFO/artwork after BT or Web media reaches the library.
# Existing images and normal NFO files are never replaced by routine enrichment.
JAV_PILOT_MEDIA_METADATA_ENABLED=1
# Compose fixes metadata state below /app/data and its library at /media/JAV.

# Read-only media fact index. Requests query SQLite; only the background scanner touches media.
JAV_PILOT_MEDIA_LIBRARY_ENABLED=1
# Compose fixes the media fact database below /app/data and scans /media/JAV.
JAV_PILOT_MEDIA_LIBRARY_RECONCILE_SECONDS=300
JAV_PILOT_MEDIA_LIBRARY_FULL_SCAN_SECONDS=86400

# History retention and its daily IANA-timezone schedule live in app_config.json.
# Automatic cleanup remains disabled until explicitly enabled in the History UI.
# VACUUM remains disabled unless maintenance mode is explicit and this points to
# one verified application backup mounted read-only below /app/backups.
JAV_PILOT_HISTORY_MAINTENANCE_MODE=0
# Host path is deployment-specific; keep real NAS paths out of this template.
JAV_PILOT_HISTORY_BACKUP_HOST_PATH=./runtime/backups
# Compose fixes the isolated, read-only container mount root at /app/backups.
JAV_PILOT_HISTORY_BACKUP_PATH=
# Compose fixes JAV_PILOT_MAINTENANCE_LOCK_ROOT=/app/maintenance-locks and mounts
# ./runtime/maintenance-locks read-write. Provision the directory as 0770 and
# its .jav-pilot-maintenance.lock as 0660, owned by the NAS operator and shared
# service group. Host backup/restore/prune commands must explicitly export
# JAV_PILOT_MAINTENANCE_LOCK_ROOT=<app-root>/runtime/maintenance-locks.

# Persistent, sanitized stage health for JavBus, JavDB, JableTV, SupJav, and MissAV probes.
# Diagnostic and search session databases are fixed below /app/data in Compose.
# Optional legacy JAV acceptance code; prefer entering JAV and FC2 codes on the Sites page.
JAV_PILOT_SITE_DIAGNOSTIC_CODE=
JAV_PILOT_SITE_DIAGNOSTIC_INTERVAL_SECONDS=900
JAV_PILOT_SITE_DIAGNOSTIC_MAX_INTERVAL_SECONDS=21600

# Production release tooling injects either an exact registry digest or the verified
# offline bundle's full-SHA tag and starts Compose with --no-build --pull never.
# Online reference format: ghcr.io/<owner>/<repository>@sha256:<digest>
# A private registry package stays private; NAS hosts without credentials load the bundle
# instead of rebuilding on the NAS or pulling anonymously.
# Leave it empty for local development; Compose then builds/tags repository:tag below.
JAV_PILOT_REVISION=unknown
JAV_PILOT_IMAGE_REFERENCE=
JAV_PILOT_IMAGE_REPOSITORY=jav-pilot
JAV_PILOT_IMAGE_TAG=dev
# Required: choose a reviewed uid:gid before Compose can start. Fresh installs
# should use a non-root identity such as 1000:1000 after preparing host ACLs.
# Existing mixed-owner NAS installs may explicitly retain 0:0 only until the
# documented ACL/UID migration has been completed and verified.
JAV_PILOT_CONTAINER_USER=
# Exact resource names belong to this Compose project. Isolated release drills
# override these names; choose unique values before running a second instance.
JAV_PILOT_COMPOSE_CONTAINER_NAME=jav-pilot
JAV_PILOT_COMPOSE_NETWORK=jav-pilot
JAV_PILOT_COMPOSE_BROWSER_PROFILE_VOLUME=jav-pilot-browser-profile
JAV_PILOT_COMPOSE_HOST_BIND=127.0.0.1
# Remote access: replace with this host's RFC1918 LAN address (for example 192.168.1.10).
JAV_PILOT_COMPOSE_LAN_BIND=127.0.0.2
JAV_PILOT_COMPOSE_HOST_PORT=8766
JAV_PILOT_HOME=/tmp
JAV_PILOT_PIDS_LIMIT=512
JAV_PILOT_SHM_SIZE=1gb
JAV_PILOT_CPU_LIMIT=4.0
JAV_PILOT_MEMORY_LIMIT=4g
JAV_PILOT_LOG_MAX_SIZE=10m
JAV_PILOT_LOG_MAX_FILES=3

# JSON schema contract: settings.json=10 and app_config.json=8. Compose fixes
# both files and detail-prefetch state below /app/data so snapshots stay complete.
# Notification targets remain write-only; never place real endpoints in this template.
JAV_PILOT_AUTH_ENABLED=1
JAV_PILOT_AUTH_USERNAME=admin
# Generate unique values before first remote start. Known placeholders are rejected.
JAV_PILOT_AUTH_PASSWORD=replace-with-unique-password-32chars
JAV_PILOT_AUTH_SECRET=replace-with-random-session-secret-at-least-48chars
# Emergency compatibility only: keeps an unsafe remote listener running and visibly warned.
JAV_PILOT_ALLOW_INSECURE_REMOTE=0
# Comma-separated exact CIDRs. Forwarded host/proto headers are ignored when empty.
JAV_PILOT_TRUSTED_PROXY_CIDRS=
