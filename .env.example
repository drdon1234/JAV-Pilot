# JAV Pilot 部署配置。复制为 .env，与 docker-compose.yml 放在同一目录。
# 只有前两项必填，其余保持默认即可运行。

# ---- 必填：登录 ----------------------------------------------------------
# 网页登录密码，至少 12 个字符，不要使用示例值。
JAV_PILOT_AUTH_PASSWORD=
# 会话密钥，至少 32 个随机字符。可用 `openssl rand -hex 32` 生成；修改后需要重新登录。
JAV_PILOT_AUTH_SECRET=
# 登录用户名。
JAV_PILOT_AUTH_USERNAME=admin

# ---- 运行身份 --------------------------------------------------------------
# 容器读写文件时使用的用户和组，填宿主机上拥有影片目录的账号，用 `id -u` / `id -g` 查看。
# 不要填 0（root），PUID=0 时容器会拒绝启动。
PUID=1000
PGID=1000

# ---- 目录 ------------------------------------------------------------------
# 宿主机路径，默认都放在本目录下。改到 NAS 共享目录时，请确保上面的 PUID/PGID 可以读写。
JAV_PILOT_DATA_HOST_PATH=./data
JAV_PILOT_LIBRARY_HOST_PATH=./media/JAV
JAV_PILOT_QB_STAGING_HOST_PATH=./downloads/jav
JAV_PILOT_WEB_DOWNLOAD_HOST_PATH=./downloads/jav-web

# ---- 访问 ------------------------------------------------------------------
# 网页端口。容器在所有网卡上监听，局域网内的其他设备可以通过 http://<本机 IP>:8766 访问；
# 不要把这个端口直接映射到公网。
JAV_PILOT_PORT=8766

# ---- 代理（可选）----------------------------------------------------------
# 所在网络无法直连站点时填写，例如宿主机 7890 端口上的代理：http://host.docker.internal:7890
JAV_PILOT_PROXY=

# ---- qBittorrent（deploy/docker-compose.qbittorrent.yml、deploy/docker-compose.full.yml 使用）
# qBittorrent WebUI 端口和 BT 监听端口。
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENTING_PORT=6881
# qBittorrent WebUI 密码（用户名 admin），至少 6 个字符。qBittorrent 首次启动前写入它的配置，
# JAV Pilot 也用它登录。配置中已有密码时不会覆盖：之后改密码请在 qBittorrent WebUI 中修改，
# 再到 JAV Pilot 的“设置 → qBittorrent”中更新。留空时 qBittorrent 使用临时密码，JAV Pilot 等你填写后再连接。
QBITTORRENT_PASSWORD=
# qBittorrent 配置目录。
QBITTORRENT_CONFIG_HOST_PATH=./qbittorrent
# 时区，影响 qBittorrent 与 Jackett 日志的时间。
TZ=Asia/Shanghai

# ---- Jackett（deploy/docker-compose.jackett.yml、deploy/docker-compose.full.yml 使用）
# Jackett 配置目录。Jackett 由 JAV Pilot 自动配置，不对外开放端口，见 docs/guide/indexers.md。
JACKETT_CONFIG_HOST_PATH=./jackett

# ---- 连接 qBittorrent（可选）----------------------------------------------
# 一般直接在 JAV Pilot 网页的“设置 → qBittorrent”中填写，网页中保存的值优先。
# 使用 deploy/docker-compose.qbittorrent.yml 或 deploy/docker-compose.full.yml 时不用填写：默认连接
# http://jav-pilot-qbittorrent:8080，用户名 admin，密码为上面的 QBITTORRENT_PASSWORD。
JAV_PILOT_QB_URL=
JAV_PILOT_QB_USERNAME=
JAV_PILOT_QB_PASSWORD=

# ---- 镜像版本（可选）------------------------------------------------------
# 默认使用最新版本；需要固定版本时改成例如 drdon1234/jav-pilot:0.1.0。
JAV_PILOT_IMAGE=drdon1234/jav-pilot:latest

# ---- 其他（可选）----------------------------------------------------------
# 本文件中的所有项都会原样传给 JAV Pilot 容器。docs/guide/configuration.md 中的其他配置项
# 也可以直接加在这里，例如 HTTPS 反向代理的地址：
# JAV_PILOT_TRUSTED_PROXY_CIDRS=172.16.0.0/12
