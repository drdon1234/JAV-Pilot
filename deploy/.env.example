# JAV Pilot 部署配置。复制为 .env，与 docker-compose.yml 放在同一目录。
# 只有前两项必填，其余保持默认即可运行。

# ---- 必填：登录 ----------------------------------------------------------
# 网页登录密码，至少 12 个字符，不要使用示例值。
JAV_PILOT_AUTH_PASSWORD=
# 会话密钥，至少 32 个随机字符。可用 `openssl rand -hex 32` 生成；修改后需要重新登录。
JAV_PILOT_AUTH_SECRET=
# 登录用户名。
JAV_PILOT_AUTH_USERNAME=admin

# ---- 运行身份 --------------------------------------------------------------
# 容器读写文件时使用的用户和组，填宿主机上拥有影片目录的账号，用 `id -u` / `id -g` 查看。
# 不要填 0（root）。
PUID=1000
PGID=1000

# ---- 目录 ------------------------------------------------------------------
# 宿主机路径，默认都放在本目录下。改到 NAS 共享目录时，请确保上面的 PUID/PGID 可以读写。
JAV_PILOT_DATA_HOST_PATH=./data
JAV_PILOT_LIBRARY_HOST_PATH=./media/JAV
JAV_PILOT_QB_STAGING_HOST_PATH=./downloads/jav
JAV_PILOT_WEB_DOWNLOAD_HOST_PATH=./downloads/jav-web

# ---- 访问 ------------------------------------------------------------------
# 网页端口。容器在所有网卡上监听，局域网内的其他设备可以通过 http://<本机 IP>:8766 访问；
# 不要把这个端口直接映射到公网。
JAV_PILOT_PORT=8766

# ---- 代理（可选）----------------------------------------------------------
# 所在网络无法直连站点时填写，例如宿主机 7890 端口上的代理：http://host.docker.internal:7890
JAV_PILOT_PROXY=

# ---- qBittorrent（仅 docker-compose.qbittorrent.yml 使用）------------------
# qBittorrent WebUI 端口和 BT 监听端口。
QBITTORRENT_WEBUI_PORT=8080
QBITTORRENT_TORRENTING_PORT=6881
# qBittorrent 配置目录。
QBITTORRENT_CONFIG_HOST_PATH=./qbittorrent
# 时区，影响 qBittorrent 日志与计划任务的时间。
TZ=Asia/Shanghai

# ---- 连接 qBittorrent（可选）----------------------------------------------
# 一般直接在 JAV Pilot 网页的“设置 → qBittorrent”中填写，网页中保存的值优先。
# 使用 docker-compose.qbittorrent.yml 时，地址填 http://qbittorrent:8080，用户名 admin。
# 请先在 qBittorrent WebUI 中设置好密码再填写地址：qBittorrent 首次启动使用随机临时密码，
# 连续登录失败会让它把 JAV Pilot 封禁一小时。
JAV_PILOT_QB_URL=
JAV_PILOT_QB_USERNAME=
JAV_PILOT_QB_PASSWORD=

# ---- 镜像版本（可选）------------------------------------------------------
# 默认使用最新版本；需要固定版本时改成例如 drdon1234/jav-pilot:0.0.1。
JAV_PILOT_IMAGE=drdon1234/jav-pilot:latest
